{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "virus/scene.schema.json",
  "title": "Virus lesson scene (./virus-courses/<topic>/scenes/lesson-NN.json)",
  "description": "A lesson's final board. Saved when the lesson closes; the next lesson's recap-board loads it. See course-mode.md.",
  "type": "object",
  "required": ["schemaVersion", "lesson", "title", "viewBox", "nodes", "arrows"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "lesson": { "type": "string", "pattern": "^lesson-[0-9]{2}$" },
    "title": { "type": "string", "minLength": 1 },
    "viewBox": { "type": "string", "pattern": "^0 0 [0-9]+ [0-9]+$" },
    "savedAt": { "type": "string", "format": "date" },
    "nodes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "w", "h", "label", "role"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "x": { "type": "number", "minimum": 0 },
          "y": { "type": "number", "minimum": 0 },
          "w": { "type": "number", "minimum": 40 },
          "h": { "type": "number", "minimum": 30 },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "role": { "type": "string", "enum": ["input", "component", "source"] }
        }
      }
    },
    "arrows": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["id", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^a[0-9]+$" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "points": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
          }
        }
      }
    }
  }
}
